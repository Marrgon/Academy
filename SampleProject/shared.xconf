<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Configuration
  SYSTEM "xconf.dtd">
<Configuration xmlns:xlink="http://www.w3.org/1999/xlink">

<!-- CR 536749 : Activate SSL communication between DB and WT -->
<Property name="wt.pom.dbConnectionPropertiesNameList" overridable="true" targetFile="db/db.properties" value="encrypt,javax.net.ssl.trustStore,"/>
<Property name="wt.pom.dbConnectionPropertiesValueList" overridable="true" targetFile="db/db.properties" value="true,{wt.jdk}/jre/lib/security \jssecacerts"/>


</Configuration>
